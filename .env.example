DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nomina_db"

# Chaves RSA em uma linha só, com \n literal no lugar das quebras de linha
# JWT_PRIVATE_KEY must be set (non-empty) or the app will not start
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_USER_ACCESS_EXPIRES_IN=900
JWT_USER_REFRESH_EXPIRES_IN=604800
USER_REFRESH_EXPIRES_IN=7

PROD_URL="https://app.example.com"
DEV_URL="http://localhost:3000"
DEPLOY_URL="https://deploy.example.com"

NODE_ENV="dev"
PORT=8080

CRON_API_KEY=""

# Chaves (>= 32 caracteres, separadas por vírgula) que o front confiável envia em
# x-nomina-internal-key para repassar o IP real em x-nomina-client-ip.
# Obrigatória com NODE_ENV=production; a segunda chave serve para rotação.
NOMINA_INTERNAL_KEYS=""
SENTRY_DSN=""

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
